# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Boleh Publishable key (sb_publishable_...) atau anon key lama.
SUPABASE_ANON_KEY=isi-dengan-publishable-key
# RAHASIA. Hanya dipakai di server (app/api dan lib). Boleh Secret key (sb_secret_...) atau service_role lama.
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-secret-key
GEMINI_API_KEY=isi-dengan-api-key-gemini
# Opsional. Model bisa diganti tanpa mengubah kode.
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional. Versi Graph API untuk WhatsApp Cloud API. Cek versi terbaru di developers.facebook.com.
WHATSAPP_API_VERSION=v26.0
# Opsional. Alamat dashboardmu, dipakai untuk tautan di notifikasi (contoh https://chat.domainmu.com).
APP_URL=
# Opsional. Notifikasi email lewat Resend (resend.com). Kosongkan kalau tidak dipakai.
RESEND_API_KEY=
# Pengirim email, contoh: Asisten Toko <notif@domainmu.com> (domain harus diverifikasi di Resend).
NOTIFY_FROM=
# Opsional. Langganan berbayar lewat Midtrans (dashboard.midtrans.com > Settings > Access Keys). Kosongkan kalau belum dipakai.
# RAHASIA, hanya di server. Pakai Server Key sandbox (SB-Mid-server-...) untuk uji coba.
MIDTRANS_SERVER_KEY=
# Isi true hanya setelah akun Midtrans lolos verifikasi dan kamu memakai Server Key production.
MIDTRANS_IS_PRODUCTION=false
# Opsional. Langganan lewat DOKU Checkout (dashboard.doku.com > Integration > API Keys). Boleh dipakai bersama Midtrans;
# pemilik toko memilih metode saat membayar. RAHASIA, hanya di server.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# true hanya untuk Client ID dan Secret Key production.
DOKU_IS_PRODUCTION=false
