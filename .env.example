# Salin ke .env (lokal) atau isi di Vercel > Settings > Environment Variables
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-dengan-anon-public-key
# RAHASIA. Hanya dipakai di server (folder api/). Jangan pernah ditaruh di file di public/.
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key
GEMINI_API_KEY=isi-dengan-api-key-gemini
# Opsional. Model bisa diganti tanpa mengubah kode.
GEMINI_MODEL=gemini-3.5-flash-lite
